+    CS_YUY2 = (1 << 2) | CS_YUV | CS_INTERLEAVED,
+    CS_YV12 = (1 << 3) | CS_YUV | CS_PLANAR,
+    CS_I420 = (1 << 4) | CS_YUV | CS_PLANAR,
+    CS_IYUV = CS_I420,
+    IT_BFF = 1 << 0,
+    IT_TFF = 1 << 1,
+    IT_FIELDBASED = 1 << 2
+  };
